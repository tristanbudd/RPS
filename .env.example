# RPS - Environment Configuration Template
# Copy this file to .env and change the values to secure your deployment.

# Database Username (Avoid using the default 'postgres')
DB_USERNAME=rps_user

# Database Password (Use a long, randomly generated secure password)
DB_PASSWORD=replace_with_a_long_secure_random_string_here

# Database Name
DB_DATABASE=rps_db

# Admin Console - GitHub OAuth configuration
# (Required to access the /admin panel)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERNAME=

# Database Storage Limit Override (Optional, in bytes. Default: 10GB)
# DATABASE_STORAGE_LIMIT_BYTES=10737418240
